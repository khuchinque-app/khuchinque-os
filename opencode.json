{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "echoes-vault-opencode",
    "@dietrichgebert/ponytail"
  ],
  "mcp": {
    "cua-driver": {
      "type": "local",
      "command": [
        "cua-driver",
        "mcp"
      ],
      "enabled": true
    },
    "ruflo": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "enabled": true
    },
    "mem0-mcp": {
      "type": "remote",
      "url": "https://mcp.mem0.ai/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer ${MEM0_API_KEY}"
      }
    },
    "membase": {
      "type": "remote",
      "url": "https://mcp.membase.so/mcp",
      "enabled": true
    },
    "gsd": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ],
      "enabled": true
    }
  },
  "skills": {
    "paths": [
      "/home/khuchinque/.opencode/khuchinque-os/skills"
    ]
  },
  "references": {
    "gsd-opencode": {
      "repository": "rokicool/gsd-opencode",
      "description": "GSD-OpenCode project lifecycle framework"
    }
  },
  "snapshot": true,
  "share": "manual",
  "autoupdate": "notify",
  "logLevel": "INFO",
  "compaction": {
    "auto": true,
    "prune": false,
    "tail_turns": 2,
    "reserved": 2048
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  },
  "attachment": {
    "image": {
      "auto_resize": true,
      "max_width": 2000,
      "max_height": 2000,
      "max_base64_bytes": 5242880
    }
  },
  "agent": {
    "gsd-advisor-researcher": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-ai-researcher": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-assumptions-analyzer": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-code-fixer": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-code-reviewer": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-codebase-mapper": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-debug-session-manager": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
    },
    "gsd-debugger": {
      "model": "bailian-coding-plan/qwen3-coder-plus"
